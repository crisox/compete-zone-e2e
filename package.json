{
  "name": "compete-zone-e2e",
  "version": "1.0.0",
  "description": "End-to-End Testing Suite for CompeteZone",
  "main": "index.js",
  "scripts": {
    "install:browsers": "playwright install --with-deps",
    "setup": "docker-compose -f docker-compose.e2e.yml up -d",
    "teardown": "docker-compose -f docker-compose.e2e.yml down -v",
    "test": "node scripts/aggressive-test-runner.js",
    "test:base": "node scripts/base-test-runner.js",
    "test:quick": "node scripts/base-test-runner.js --skip-services --skip-data-load",
    "test:services": "node scripts/base-test-runner.js --services-only",
    "test:smoke": "node scripts/base-test-runner.js --test-pattern=tests/smoke",
    "test:events": "node scripts/base-test-runner.js --test-pattern=tests/e2e/events",
    "test:auth": "node scripts/base-test-runner.js --test-pattern=tests/e2e/auth",
    "test:debug": "node scripts/base-test-runner.js --verbose --workers=1",
    "test:ui": "playwright test --ui",
    "logs": "docker-compose -f docker-compose.e2e.yml logs -f",
    "logs:services": "docker-compose -f docker-compose.e2e.yml logs -f postgres-e2e api-e2e frontend-e2e",
    "logs:dozzle": "open http://localhost:8086",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "node -e \"const { config } = require('./utils/config'); const validation = config.validate(); if (!validation.isValid) { console.error('Configuration errors:', validation.errors); process.exit(1); } else { console.log('✅ Configuration is valid'); }\""
  },
  "keywords": [
    "e2e",
    "testing",
    "playwright",
    "competezone",
    "automation"
  ],
  "author": "CompeteZone Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-playwright": "^1.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "faker": "^6.6.6",
    "pg": "^8.11.0",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "playwright": {
    "version": "1.40.0"
  }
}
