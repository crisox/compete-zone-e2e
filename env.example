# =============================================================================
# Variables de Entorno para Pruebas E2E - CompeteZone
# =============================================================================

# URLs de Servicios
API_URL=http://localhost:8082
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=5435
DB_NAME=competezone_e2e
DB_USER=postgres
DB_PASSWORD=postgres

# Configuración de Playwright
PLAYWRIGHT_BROWSERS=0
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=60000
PLAYWRIGHT_RETRIES=2

# Configuración de Reportes
PLAYWRIGHT_REPORTER=html,junit
PLAYWRIGHT_OUTPUT_DIR=reports

# Datos de Prueba - Usuarios de Test
TEST_ADMIN_EMAIL=admin@competezone.test
TEST_ADMIN_PASSWORD=admin123
TEST_ADMIN_NAME=Admin Test
TEST_ADMIN_ROLE=admin

TEST_ATHLETE_EMAIL=athlete@competezone.test
TEST_ATHLETE_PASSWORD=athlete123
TEST_ATHLETE_NAME=Athlete Test
TEST_ATHLETE_ROLE=athlete
TEST_ATHLETE_BIO=Test athlete bio
TEST_ATHLETE_LOCATION=Madrid, Spain

TEST_GYM_EMAIL=gym@competezone.test
TEST_GYM_PASSWORD=gym123
TEST_GYM_NAME=Test Gym
TEST_GYM_ROLE=gym
TEST_GYM_DESCRIPTION=Test gym description
TEST_GYM_ADDRESS=Test Address 123
TEST_GYM_PHONE=+34 123 456 789

# Configuración de API
API_TIMEOUT=10000
API_RETRIES=3

# Configuración de Base de Datos
DB_CONNECTION_TIMEOUT=5000
DB_QUERY_TIMEOUT=30000

# Configuración de Media
MEDIA_UPLOAD_PATH=./volumes/media-uploads-e2e
MEDIA_MAX_SIZE_MB=10

# Configuración de Logs
LOG_LEVEL=info
LOG_FILE=reports/playwright.log

# Configuración de CI/CD
CI=false
GITHUB_ACTIONS=false
GITLAB_CI=false

# Configuración de Desarrollo
NODE_ENV=test
DEBUG=playwright:*
